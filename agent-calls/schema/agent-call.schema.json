{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentCallResult",
  "description": "Contract for .codebuddy/agent-calls/<requestId>.result.json",
  "type": "object",
  "required": ["requestId", "status"],
  "properties": {
    "requestId": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["planner", "manual-task"] },
    "status": { "type": "string", "enum": ["success", "failed", "blocked"] },
    "output": {},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "path"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "error": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      },
      "additionalProperties": true
    },
    "completedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "success" } }, "required": ["status"] },
      "then": { "required": ["output"] }
    },
    {
      "if": {
        "properties": { "kind": { "const": "planner" }, "status": { "const": "success" } },
        "required": ["kind", "status"]
      },
      "then": { "properties": { "output": { "$ref": "#/$defs/plannerOutput" } } }
    },
    {
      "if": {
        "properties": { "kind": { "const": "manual-task" }, "status": { "const": "success" } },
        "required": ["kind", "status"]
      },
      "then": { "properties": { "output": { "$ref": "#/$defs/manualTaskOutput" } } }
    }
  ],
  "$defs": {
    "plannerOutput": {
      "type": "object",
      "required": ["tasks"],
      "properties": {
        "tasks": {
          "type": "array",
          "items": { "$ref": "#/$defs/plannerTask" }
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "plannerTask": {
      "type": "object",
      "required": ["planId", "title", "type"],
      "properties": {
        "planId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["analysis", "design", "test", "implement", "review"] },
        "priority": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "acceptanceCriteria": { "type": "array", "items": { "type": "string" } },
        "scope": {
          "type": "object",
          "properties": {
            "files": { "type": "array", "items": { "type": "string" } },
            "modules": { "type": "array", "items": { "type": "string" } },
            "tags": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "manualTaskOutput": {
      "type": "object",
      "required": ["actualWork"],
      "properties": {
        "actualWork": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
