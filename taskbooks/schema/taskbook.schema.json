{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/taskbook.schema.json",
  "title": "TaskBook",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "taskType",
    "createdAt",
    "status",
    "context",
    "tasks",
    "changelog"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "taskType": { "$ref": "#/$defs/taskBookType" },
    "createdAt": { "type": "string", "format": "date-time" },
    "revision": { "type": "integer", "minimum": 0 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "confirmedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "status": { "$ref": "#/$defs/taskBookStatus" },
    "plan": { "$ref": "#/$defs/taskBookPlan" },
    "context": { "$ref": "#/$defs/context" },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/taskItem" }
    },
    "changelog": {
      "type": "array",
      "items": { "$ref": "#/$defs/changeEntry" }
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "taskBookStatus": {
      "type": "string",
      "enum": ["draft", "confirmed", "executing", "completed", "aborted"]
    },
    "taskBookType": {
      "type": "string",
      "enum": ["new-feature", "refactoring", "debugging", "testing", "code-review"]
    },
    "taskType": {
      "type": "string",
      "enum": [
        "requirement",
        "prd",
        "analysis",
        "design",
        "test",
        "implement",
        "refactor",
        "review",
        "build-fix",
        "acceptance"
      ]
    },
    "taskStatus": {
      "type": "string",
      "enum": ["pending", "in_progress", "done", "blocked", "skipped"]
    },
    "taskPriority": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low"]
    },
    "taskAgentHint": {
      "type": "string",
      "enum": ["coder", "tester", "reviewer", "refactor", "doc-writer", "planner"]
    },
    "taskSpecMode": {
      "type": "string",
      "enum": ["inline-open-spec", "linked-spec-kit"],
      "description": "Spec 粒度由 routing/编排先决定，再作为 Planner 的输入约束。第一阶段不支持执行中动态升级。"
    },
    "changeType": {
      "type": "string",
      "enum": ["added", "modified", "removed", "reordered"]
    },
    "projectHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "issues"],
      "properties": {
        "score": { "type": "number" },
        "issues": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relatedFiles", "dependencies"],
      "properties": {
        "projectHealth": { "$ref": "#/$defs/projectHealth" },
        "relatedFiles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "architectureNotes": { "type": "string" }
      }
    },
    "taskBookPlanRisk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "summary"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "summary": { "type": "string", "minLength": 1 },
        "mitigation": { "type": "string" }
      }
    },
    "taskBookPlanEpic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" }
      }
    },
    "taskBookPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planId", "version"],
      "properties": {
        "planId": {
          "type": "string",
          "minLength": 1,
          "description": "第一阶段强制 1 TaskBook = 1 Plan，planId 应与 taskBook.id 一致。"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "第一阶段固定为 1，暂不支持 re-planning 的版本分支。"
        },
        "specMode": { "$ref": "#/$defs/taskSpecMode" },
        "recommendedWorkflowId": {
          "type": "string",
          "enum": ["micro", "sprint", "default"]
        },
        "summary": { "type": "string" },
        "goals": {
          "type": "array",
          "items": { "type": "string" }
        },
        "outOfScope": {
          "type": "array",
          "items": { "type": "string" }
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "risks": {
          "type": "array",
          "items": { "$ref": "#/$defs/taskBookPlanRisk" }
        },
        "clarifications": {
          "type": "array",
          "items": { "type": "string" }
        },
        "epics": {
          "type": "array",
          "items": { "$ref": "#/$defs/taskBookPlanEpic" }
        },
        "specRef": {
          "type": "string",
          "description": "复杂任务可指向 .codebuddy/specs/<taskBookId>-v<version>/ 下的 Spec Kit。"
        },
        "linkedTaskBookRevision": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "type": "string",
          "enum": ["planner", "manual", "task-intake-routing"]
        }
      }
    },
    "taskExecutionSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string" },
        "agentHint": { "$ref": "#/$defs/taskAgentHint" },
        "deliverables": {
          "type": "array",
          "items": { "type": "string" }
        },
        "verification": {
          "type": "array",
          "items": { "type": "string" },
          "description": "技术/工程层校验：lint、test、build、smoke、人工检查点等。不要与 acceptanceCriteria 的业务验收混淆。"
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dependenciesNote": { "type": "string" },
        "specRef": { "type": "string" }
      }
    },
    "taskItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "type",
        "status",
        "priority",
        "dependencies",
        "acceptanceCriteria"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "parentId": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/taskType" },
        "status": { "$ref": "#/$defs/taskStatus" },
        "priority": { "$ref": "#/$defs/taskPriority" },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": { "type": "string" },
          "description": "业务/结果层验收标准：完成后用户或业务应得到什么结果。"
        },
        "scope": { "$ref": "#/$defs/taskScope" },
        "executionSpec": { "$ref": "#/$defs/taskExecutionSpec" },
        "actualWork": { "type": "string" },
        "blockedReason": { "type": "string" },
        "executedBy": { "type": "string" },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "handoffs": {
          "type": "array",
          "items": { "$ref": "#/$defs/handoffEntry" }
        }
      }
    },
    "handoffEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type", "timestamp"],
      "properties": {
        "from": { "type": "string", "minLength": 1, "description": "来源 Agent ID" },
        "to": { "type": "string", "minLength": 1, "description": "目标 Agent ID" },
        "type": {
          "type": "string",
          "enum": ["standard", "qa_pass", "qa_fail", "escalation"],
          "description": "交接类型"
        },
        "timestamp": { "type": "string", "format": "date-time" },
        "context": { "type": "string", "description": "交接上下文摘要" },
        "deliverables": {
          "type": "array",
          "items": { "type": "string" },
          "description": "交付物文件列表"
        }
      }
    },
    "taskScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "modules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "changeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "taskId", "changeType", "reason"],
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "taskId": { "type": ["string", "null"] },
        "changeType": { "$ref": "#/$defs/changeType" },
        "reason": { "type": "string" },
        "before": {
          "type": "object",
          "additionalProperties": true
        },
        "after": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
