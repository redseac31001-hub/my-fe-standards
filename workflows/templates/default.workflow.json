{
  "id": "default",
  "version": "2.0.0",
  "name": "Default Workflow (7-step closed loop)",
  "description": "Tool/model-agnostic 7-step workflow: requirement+PRD -> analyze -> plan -> TDD implement (batched + smoke gates) -> review -> build+fix -> acceptance/archive.",
  "steps": [
    {
      "id": "requirement_prd",
      "type": "requirement_and_prd",
      "title": "Requirement clarification & PRD generation",
      "description": "Clarify requirements through structured Q&A and generate PRD with user stories and acceptance criteria.",
      "skipWhen": "no_tasks_of_type:requirement,prd",
      "toolHints": {
        "recommended": ["skill:prd", "human"]
      },
      "outputs": {
        "prd": ".codebuddy/docs/prd-*.md"
      }
    },
    {
      "id": "analyze",
      "type": "analyze_project",
      "title": "Analyze project structure/modules",
      "description": "Generate architecture/module reports to support planning and impact analysis.",
      "skipWhen": "no_tasks_of_type:analysis",
      "toolHints": {
        "recommended": ["script:structure-analyzer", "script:module-mapper"]
      },
      "outputs": {
        "reports": [".codebuddy/reports/architecture/latest.json", ".codebuddy/reports/modules/latest.json"]
      }
    },
    {
      "id": "plan",
      "type": "create_taskbook",
      "title": "Create TaskBook (tasks + acceptance criteria)",
      "description": "Break requirements into executable tasks with dependencies and acceptance criteria. Technical design is embedded in task decomposition.",
      "toolHints": {
        "recommended": ["agent:planner", "script:taskbook-manager"]
      },
      "outputs": {
        "taskbook": ".codebuddy/taskbooks/active/tb-*.json"
      }
    },
    {
      "id": "tdd_implement",
      "type": "tdd_implement",
      "title": "Test-first implementation (TDD batched)",
      "description": "Execute tasks using TDD cycle (RED->GREEN->REFACTOR) in batches controlled by policies.testing.batching; run smoke gates between batches.",
      "gates": ["contracts_valid", "smoke_passed"],
      "toolHints": {
        "recommended": ["agent:tdd-driver", "agent:task-orchestrator", "human"]
      }
    },
    {
      "id": "review",
      "type": "code_review",
      "title": "Code review gate",
      "description": "Perform code review (and optionally security/performance review).",
      "gates": ["review_passed"],
      "toolHints": {
        "recommended": ["agent:code-reviewer", "agent:security-reviewer", "agent:performance-profiler", "human"]
      }
    },
    {
      "id": "build_fix",
      "type": "build_and_fix",
      "title": "Build verification & auto-fix",
      "description": "Run full build/typecheck/lint pipeline. On failure, auto-diagnose and fix errors up to 3 rounds.",
      "gates": ["contracts_valid", "lint_passed", "typecheck_passed", "full_passed"],
      "toolHints": {
        "recommended": ["agent:build-fix", "shell:npm run build", "shell:npm test"]
      }
    },
    {
      "id": "acceptance",
      "type": "acceptance_and_archive",
      "title": "Acceptance & Archive",
      "description": "Generate acceptance report and archive TaskBook to history.",
      "toolHints": {
        "recommended": ["script:taskbook-manager", "human"]
      }
    }
  ],
  "edges": [
    { "from": "requirement_prd", "to": "analyze" },
    { "from": "analyze", "to": "plan" },
    { "from": "plan", "to": "tdd_implement" },
    { "from": "tdd_implement", "to": "review" },
    { "from": "review", "to": "build_fix" },
    { "from": "build_fix", "to": "acceptance" }
  ],
  "gates": [
    {
      "id": "contracts_valid",
      "type": "checks",
      "title": "Contracts (TaskBook/Workflow) validated",
      "required": true,
      "params": {
        "commands": ["node .codebuddy/scripts/contract-validator.js --workflows --taskbooks --check-batching-scope"]
      }
    },
    {
      "id": "smoke_passed",
      "type": "checks",
      "title": "Smoke tests passed",
      "required": true,
      "params": {
        "budgetMinutes": 5,
        "commands": ["npm test"]
      }
    },
    {
      "id": "lint_passed",
      "type": "checks",
      "title": "Lint passed (optional)",
      "required": false,
      "params": {
        "budgetMinutes": 5,
        "npmScripts": ["lint"]
      }
    },
    {
      "id": "typecheck_passed",
      "type": "checks",
      "title": "Typecheck passed (optional)",
      "required": false,
      "params": {
        "budgetMinutes": 10,
        "npmScripts": ["typecheck"]
      }
    },
    {
      "id": "security_passed",
      "type": "checks",
      "title": "Security checks passed (optional)",
      "required": false,
      "params": {
        "budgetMinutes": 10,
        "npmScripts": ["security"]
      }
    },
    {
      "id": "perf_passed",
      "type": "checks",
      "title": "Performance checks passed (optional)",
      "required": false,
      "params": {
        "budgetMinutes": 15,
        "npmScripts": ["perf"]
      }
    },
    {
      "id": "full_passed",
      "type": "checks",
      "title": "Full tests/build passed",
      "required": true,
      "params": {
        "budgetMinutes": 20,
        "commands": ["npm test", "npm run build"]
      }
    },
    {
      "id": "review_passed",
      "type": "review",
      "title": "Review passed",
      "required": true,
      "params": {
        "checklist": ["self-verification", "defensive-coding", "clean-code"]
      }
    }
  ],
  "policies": {
    "concurrency": {
      "maxParallelTasks": 1,
      "conflictStrategy": "deny_same_file_set"
    },
    "blocking": {
      "onGateFail": "blocked",
      "requiresHumanToUnblock": true
    },
    "testing": {
      "budgetsMinutes": { "smoke": 5, "full": 20 },
      "batching": {
        "strategy": "risk_tiered",
        "riskTiers": {
          "high": { "maxFiles": 3, "maxChangedLines": 200, "smokeEveryBatches": 1 },
          "medium": { "maxFiles": 10, "maxChangedLines": 800, "smokeEveryBatches": 1 },
          "low": { "maxFiles": 25, "maxChangedLines": 2000, "smokeEveryBatches": 2 }
        },
        "autoTune": { "stableBatches": 3, "increaseFactor": 1.5, "decreaseFactor": 0.5 }
      }
    },
    "buildFix": {
      "maxRounds": 3,
      "retryFromStep": "tdd_implement",
      "escalateToHuman": true
    }
  }
}
