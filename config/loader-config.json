{
    "$schema": "./loader-config.schema.json",
    "_comment": "CodeBuddy GLM-4.7 专用配置 - 完整三层架构版",
    "mode": "codebuddy",
    "aiTool": {
        "name": "CodeBuddy",
        "model": "GLM-4.7",
        "tools": {
            "readFile": "read_file",
            "searchContent": "search_content",
            "searchFile": "search_file",
            "listFiles": "list_files",
            "replaceInFile": "replace_in_file"
        }
    },
    "layers": {
        "base": {
            "id": "layer1_base",
            "title": "Layer 1: 基础规范",
            "staticDeps": ["code-quality", "architecture", "typescript"],
            "loadMode": "eager",
            "_comment": "Vue 版本由脚本动态检测"
        },
        "business": {
            "id": "layer2_business",
            "title": "Layer 2: 业务规范",
            "dependencies": {
                "ant-design-vue": ["antdv"],
                "vant": ["vant"]
            },
            "loadMode": "lazy",
            "_comment": "key=npm包名, value=对应要加载的规则文件夹名数组"
        },
        "action": {
            "id": "layer3_action",
            "title": "Layer 3: 任务检查清单",
            "defaults": ["refactoring", "debugging", "testing", "self-verification", "defensive-coding", "context-management"],
            "loadMode": "lazy",
            "_comment": "defaults 始终加载，可通过 --task 参数筛选"
        }
    },
    "tasks": {
        "_comment": "任务类型定义 - 用于渐进式披露，按任务筛选相关规则",
        "definitions": {
            "refactoring": {
                "name": "重构",
                "description": "代码重构、优化、清理技术债务",
                "aliases": ["refactor", "optimize", "cleanup"]
            },
            "debugging": {
                "name": "调试",
                "description": "Bug 修复、问题排查、错误处理",
                "aliases": ["debug", "fix", "bugfix", "troubleshoot"]
            },
            "testing": {
                "name": "测试",
                "description": "编写测试、测试策略、覆盖率",
                "aliases": ["test", "unit-test", "e2e"]
            },
            "new-feature": {
                "name": "新功能",
                "description": "开发新功能、添加新特性",
                "aliases": ["feature", "implement", "add"]
            },
            "code-review": {
                "name": "代码审查",
                "description": "代码审查、PR 审核",
                "aliases": ["review", "pr"]
            }
        },
        "ruleRelevance": {
            "_comment": "规则与任务的相关性 (0-1)，未列出的默认为 0.5",
            "layer1_base": {
                "code-quality/clean-code": {
                    "refactoring": 1.0,
                    "new-feature": 0.95,
                    "code-review": 1.0,
                    "debugging": 0.8,
                    "testing": 0.7
                },
                "architecture/feature-based-structure": {
                    "refactoring": 0.9,
                    "new-feature": 0.95,
                    "code-review": 0.8,
                    "debugging": 0.3,
                    "testing": 0.4
                },
                "typescript/strict-types": {
                    "refactoring": 0.85,
                    "new-feature": 0.9,
                    "code-review": 0.9,
                    "debugging": 0.7,
                    "testing": 0.6
                }
            },
            "layer3_action": {
                "refactoring": {
                    "refactoring": 1.0,
                    "code-review": 0.8,
                    "new-feature": 0.4
                },
                "debugging": {
                    "debugging": 1.0,
                    "refactoring": 0.4,
                    "code-review": 0.5
                },
                "testing": {
                    "testing": 1.0,
                    "code-review": 0.7,
                    "new-feature": 0.6
                },
                "self-verification": {
                    "code-review": 1.0,
                    "refactoring": 0.8,
                    "new-feature": 0.7
                }
            }
        },
        "thresholds": {
            "_comment": "相关性阈值，低于此值的规则不加载",
            "default": 0.5,
            "strict": 0.7,
            "loose": 0.3
        }
    },
    "skills": {
        "_comment": "自定义技能配置 - CodeBuddy 已支持 Skills 功能",
        "enabled": true,
        "path": "custom-skills",
        "loadMode": "lazy"
    },
    "mcpServer": {
        "_comment": "MCP Server 配置 - CodeBuddy 已支持，待后续实现",
        "enabled": false,
        "path": "mcp-server"
    },
    "structureAnalyzer": {
        "_comment": "项目结构分析器配置",
        "thresholds": {
            "maxFileLines": 500,
            "maxDirectoryDepth": 5,
            "maxFileSizeKB": 100,
            "similarityThreshold": 0.8
        },
        "enabledRules": ["SA001", "SA002", "SA003", "SA004", "SA005"],
        "ignorePatterns": ["node_modules", "dist", ".git", "*.min.js", "*.map", "coverage"],
        "typeGroupedPatterns": ["components", "views", "store", "stores", "utils", "hooks", "services", "helpers", "api", "apis"],
        "sa001Whitelist": ["components", "shared", "common", "assets", "styles", "types", "constants"],
        "sa001MinFiles": 10,
        "sa004": {
            "enabled": true,
            "similarityThreshold": 0.8,
            "maxPairsPerDirectory": 50,
            "maxTotalChecks": 500,
            "minNameLength": 3
        }
    },
    "output": {
        "dirName": ".codebuddy/rules",
        "fileName": "project-rules.md"
    },
    "frontmatter": {
        "description": "前端架构规范 - CodeBuddy GLM-4.7 专用版",
        "alwaysApply": true,
        "enabled": true
    }
}
