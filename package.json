{
  "name": "my-fe-standards",
  "version": "1.0.0",
  "description": "前端架构师规则库 - AI 编程助手知识源",
  "dependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "build:scripts": "tsc -p scripts/tsconfig.json",
    "build:manifest": "node scripts/dist/generate-manifest.js",
    "build": "npm run build:scripts && npm run build:manifest",
    "test:local": "node scripts/dist/rule-loader.js",
    "test:remote": "node scripts/dist/rule-loader.js --remote http://localhost:8080",
    "test:remote:github": "node scripts/dist/rule-loader.js --remote https://raw.githubusercontent.com/redseac31001-hub/my-fe-standards/feature/remote-fetch",
    "remote:github": "curl -fsSL https://raw.githubusercontent.com/redseac31001-hub/my-fe-standards/feature/remote-fetch/scripts/dist/rule-loader.js | node - --remote https://raw.githubusercontent.com/redseac31001-hub/my-fe-standards/feature/remote-fetch",
    "test:remote:full": "node test/test-remote-full.js",
    "test:integration": "node test/run-tests.js"
  }
}
